FROM node:22-bookworm

# System deps + jj (Jujutsu VCS) prebuilt binary.
RUN apt-get update && apt-get install -y \
  git \
  curl \
  jq \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Install jj — host repo is jj-colocated; container needs jj for any
# vpr/jj-aware tooling that runs during ralph iterations. Pin to a known
# release so container behaviour is reproducible.
ARG JJ_VERSION=0.30.0
RUN curl -fsSL "https://github.com/jj-vcs/jj/releases/download/v${JJ_VERSION}/jj-v${JJ_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    | tar -xz -C /usr/local/bin jj \
  && jj --version

# GitHub CLI — handy for ralph if it needs to inspect existing PRs.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
  && apt-get update && apt-get install -y gh \
  && rm -rf /var/lib/apt/lists/*

# Rename node user → agent (preserves UID 1000 for bind-mount ownership).
RUN usermod -d /home/agent -m -l agent node
USER agent

# Claude Code CLI.
RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/home/agent/.local/bin:$PATH"

WORKDIR /home/agent

# Sandcastle bind-mounts the worktree at /home/agent/workspace and
# overrides cwd at container start. Keep the entrypoint a sleeper so
# sandcastle can `docker exec` against a long-lived container.
ENTRYPOINT ["sleep", "infinity"]
